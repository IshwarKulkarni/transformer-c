$GloveEmbDim: 300

Input: text_input
batch: $batch
height: 128
width: $GloveEmbDim

FeedForward: reducer
prev: text_input
out_dim: 256
dropout: 0.15
bias: true
act: LeakyReLU

PositionalEncoding: pe_reduced
prev: reducer

MultiHeadSelfAttention: text_encoder
num_heads: 4
prev: pe_reduced
out_dim: 64
bias: false
act: LeakyReLU

Mean: mean
prev: text_encoder
dim: 1

FeedForward: decoder
prev: mean
out_dim: 5
bias: true
act: LeakyReLU

