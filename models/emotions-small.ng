$GloveEmbDim: 300

Input: text-input
batch: $batch
height: 16
width: $GloveEmbDim

Linear: linear
prev: text-input
out_dim: 32
bias: true
act: LeakyReLU

FeedForward: reducer
prev: linear
out_dim: 5
intermediate_dim: 32
l1_act: sigmoid
rate1: 0.15
rate2: 0.15
bias: true
act: LeakyReLU

Mean: mean
dim: 1
prev: reducer

Input: target
batch: $batch
height: 1
width: reducer->out_dim

L2Loss: l2loss
pred: mean
tgt: target
